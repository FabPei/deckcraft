{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "{env:MIMO_BASE_URL}",
        "apiKey": "{env:MIMO_API_KEY}"
      },
      "models": {
        "mimo-v2.6-flash": {
          "name": "mimo-v2.6-flash",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "mimo-v2.6-pro": {
          "name": "mimo-v2.6-pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "task": "deny",
    "question": "deny",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Minimal Rust fixes; read/write files but cannot execute shell or use network tools.",
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "task": "deny",
        "question": "deny"
      }
    },
    "reviewer": {
      "mode": "primary",
      "description": "Independent read-only change reviewer.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "task": "deny",
        "question": "deny"
      }
    }
  }
}
